---
// The "explore" button: the Wardlight's crystal in a glowing pill. It opens a detail view (open = the dialog's id,
// page = which of its pages); the view grows out of the button.
interface Props { label: string; open: string; page?: number }
const { label, open, page } = Astro.props;
---
<button class="more" type="button" data-open={open} data-page={page} aria-haspopup="dialog">
  <span class="gem" aria-hidden="true"><img src="/assets/brand/wardlight-crystal.svg" alt="" width="14" height="23"></span>
  <span class="lbl">{label}</span>
</button>
